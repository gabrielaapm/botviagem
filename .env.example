# Copie para .env e ajuste. O bot lê esse arquivo na pasta de onde você roda o npm start.

# mock = ofertas de exemplo (não fala com a internet)
# playwright = Google Flights no Chromium (precisa: npx playwright install chromium)
# api = GET no FLIGHT_API_URL (JSON documentado no README)
SEARCH_ADAPTER=playwright

# Horário de Brasília. As buscas rodam 03:00, 09:00, 14:00 e 19:00.
TZ=America/Sao_Paulo
CHECK_HOURS=3,9,14,19

# Teto de posts no grupo por dia (fuso acima). 6 é o padrão de propósito.
MAX_POSTS_PER_DAY=6

# GRU/CGH São Paulo, GIG/SDU Rio, REC Recife, VCP Campinas.
ORIGINS=GRU,CGH,GIG,SDU,REC,VCP

# Nome da agência (legado / prévia). A mensagem do grupo atual não usa rodapé de marca.
BRAND_NAME=[Sua Agência]

# Pasta de ofertas, sessão do WhatsApp e QR.
DATA_DIR=./data

# Tela local de aprovação. Deixe em 127.0.0.1.
WEB_HOST=127.0.0.1
WEB_PORT=3847

# false = só fila local / log (sem WhatsApp). true = QR + envio no grupo após aprovar.
WHATSAPP_ENABLED=false

# JID do grupo, tipo 120363...@g.us (opcional; também dá para escolher na tela).
WHATSAPP_GROUP_JID=

# PV do adm/cliente: recebe o link Google Flights depois da aprovação no grupo.
# Aceita também ADMIN_WHATSAPP_JID. Não use o mesmo número da sessão do bot.
WHATSAPP_ADMIN_JID=

# Só quando SEARCH_ADAPTER=api
FLIGHT_API_URL=
FLIGHT_API_KEY=

# Só quando SEARCH_ADAPTER=playwright
PLAYWRIGHT_HEADLESS=true
